
#!/bin/bash

if [ "$#" -ne 1 ]; then
    echo "Kasutamine: $0 failinimi"
    exit 1
fi

if [ "$EUID" -ne 0 ]; then
    echo "Viga: käivita skript root-kasutajana."
    exit 1
fi

FAIL="$1"

if [ ! -f "$FAIL" ]; then
    echo "Viga: faili $FAIL ei leitud."
    exit 1
fi

while IFS=: read -r KASUTAJA PAROOL || [ -n "$KASUTAJA" ]; do
    [ -z "$KASUTAJA" ] && continue

    if id "$KASUTAJA" >/dev/null 2>&1; then
        echo "Viga: kasutaja $KASUTAJA on juba olemas."
        exit 1
    fi

    useradd -m -d "/home/$KASUTAJA" -s /bin/bash "$KASUTAJA" || exit 1

    if printf '%s:%s\n' "$KASUTAJA" "$PAROOL" | chpasswd; then
        echo "Kasutaja $KASUTAJA loodud ja parool määratud."
    else
        echo "Viga: parooli määramine ebaõnnestus."
        exit 1
    fi
done < "$FAIL"
